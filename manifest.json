{
  "manifest_version": 3,
  "name": "JARVIS Extension",
  "version": "1.0.0",
  "description": "Voice-first JARVIS holographic assistant for Chrome.",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:11434/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JARVIS",
    "default_popup": "hud.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}